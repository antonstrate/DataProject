import numpy as np
import matplotlib.pyplot as plt


# ============================================================
# 2.1 The model
# ============================================================

class IncomeModel:
    """Life-cycle model for income distribution."""

    def __init__(self, seed=123):
        """Set parameters and random number generator."""

        # a. settings
        self.N = 50_000
        self.age_min = 18
        self.age_max = 65

        # b. education
        self.p_e = np.array([0.40, 0.35, 0.25])
        self.S_e = np.array([1, 3, 5])
        self.h_e0 = np.array([1.00, 1.20, 1.55])
        self.delta_e = np.array([0.010, 0.020, 0.030])

        # c. labor market
        self.delta = 0.06
        self.sigma_psi = 0.10
        self.lambda_ = 0.60
        self.sigma = 0.05

        # d. income
        self.y_SU = 0.45
        self.rho = 0.60
        self.y_floor = 0.35

        # e. random numbers
        self.rng = np.random.default_rng(seed)

    def simulate(self):
        """Simulate the life-cycle model."""

        # a. setup
        self.ages = np.arange(
            self.age_min,
            self.age_max + 1
        )

        T = len(self.ages)

        self.education = self.rng.choice(
            3,
            size=self.N,
            p=self.p_e
        )

        education_years = self.S_e[self.education]

        self.employed = np.zeros(
            (self.N, T),
            dtype=bool
        )

        self.h = np.zeros((self.N, T))
        self.income = np.zeros((self.N, T))

        self.h[:, 0] = self.h_e0[self.education]

        last_job_income = np.zeros(self.N)

        # b. simulate over ages
        for t, age in enumerate(self.ages):

            in_education = (
                age < self.age_min + education_years
            )

            active = ~in_education

            just_finished = (
                age == self.age_min + education_years
            )

            if t > 0:

                was_employed = self.employed[:, t - 1]

                find_job = (
                    self.rng.random(self.N)
                    < self.lambda_
                )

                lose_job = (
                    self.rng.random(self.N)
                    < self.sigma
                )

                self.employed[:, t] = (
                    (was_employed & ~lose_job)
                    | (active & ~was_employed & find_job)
                )

                self.employed[just_finished, t] = False
                self.employed[in_education, t] = False

                # Shock from the hint
                psi = self.rng.lognormal(
                    -0.5 * self.sigma_psi**2,
                    self.sigma_psi,
                    size=self.N
                )

                self.h[:, t] = self.h[:, t - 1]

                employed = self.employed[:, t]

                unemployed = (
                    active
                    & ~employed
                    & ~just_finished
                )

                # Human capital when employed
                self.h[employed, t] = (
                    self.h[employed, t - 1]
                    * (
                        1
                        + self.delta_e[
                            self.education[employed]
                        ]
                    )
                    * psi[employed]
                )

                # Human capital when unemployed
                self.h[unemployed, t] = (
                    self.h[unemployed, t - 1]
                    * (1 - self.delta)
                    * psi[unemployed]
                )

            # c. income
            employed = self.employed[:, t]
            unemployed = active & ~employed

            # In education
            self.income[in_education, t] = self.y_SU

            # Employed
            self.income[employed, t] = self.h[employed, t]

            # Previously employed
            has_worked = last_job_income > 0

            self.income[
                unemployed & has_worked, t
            ] = (
                self.rho
                * last_job_income[
                    unemployed & has_worked
                ]
            )

            # Never employed
            self.income[
                unemployed & ~has_worked, t
            ] = self.y_floor

            # Save last job income
            last_job_income[employed] = (
                self.income[employed, t]
            )


# ============================================================
# 2.2 Simulate the income distribution
# ============================================================

model = IncomeModel(seed=123)
model.simulate()


# ============================================================
# 2.2.1 Check the simulation
# ============================================================

# a. education shares
print("Education shares:")

for e in range(3):
    share = np.mean(model.education == e)
    print(e, share)

print("Expected:", model.p_e)


# b. unemployment rate
u_ss = model.sigma / (
    model.sigma + model.lambda_
)

education_years = model.S_e[model.education]

for t, age in enumerate(model.ages):

    active = (
        age >= model.age_min + education_years
    )

    if np.any(active):
        unemployment_rate = np.mean(
            ~model.employed[active, t]
        )

# Compare final unemployment with steady state
print(
    "Final unemployment rate:",
    unemployment_rate
)

print(
    "Steady-state unemployment:",
    u_ss
)


# ============================================================
# 2.2.2 Mean and selected percentiles of income
# ============================================================

mean_income = np.mean(
    model.income,
    axis=0
)

percentiles = np.percentile(
    model.income,
    [10, 25, 50, 75, 90],
    axis=0
)

plt.figure()

plt.plot(
    model.ages,
    mean_income,
    label="Mean"
)

for i, p in enumerate(
    [10, 25, 50, 75, 90]
):
    plt.plot(
        model.ages,
        percentiles[i],
        label=f"{p}th percentile"
    )

plt.xlabel("Age")
plt.ylabel("Income")
plt.title("Income over the life cycle")
plt.legend()
plt.show()


# ============================================================
# 2.2.3 Income distributions
# ============================================================

ages_hist = [25, 35, 45, 60]

for age in ages_hist:

    t = np.where(
        model.ages == age
    )[0][0]

    plt.figure()

    plt.hist(
        model.income[:, t],
        bins=50
    )

    plt.xlabel("Income")
    plt.ylabel("Number of individuals")
    plt.title(
        f"Income distribution at age {age}"
    )

    plt.show()






# ============================================================
# 2.3 Compute the Gini coefficient
# ============================================================


# a. Gini function
# We sort incomes from lowest to highest and calculate
# the Gini coefficient using the standard Gini formula.

def gini(x):
    """Compute the Gini coefficient."""

    x = np.sort(x)
    N = len(x)

    index = np.arange(1, N + 1)

    G = (
        2 * np.sum(index * x)
        / (N * np.sum(x))
        - (N + 1) / N
    )

    return G


# b. test the Gini function
# The Gini coefficient of a uniform distribution on [0,1]
# should be approximately 1/3.

rng = np.random.default_rng(123)

x_test = rng.uniform(
    0,
    1,
    size=100_000
)

print("Test Gini:", gini(x_test))
print("Expected:", 1 / 3)


# c. Gini for the full simulated sample
# flatten() combines income for all individuals and all ages
# into one vector.

income_all = model.income.flatten()

gini_all = gini(income_all)

print("Gini, all ages:", gini_all)


# d. Lorenz curve
# First sort all incomes from lowest to highest.

income_sorted = np.sort(income_all)

# Calculate the cumulative share of total income.

income_share = (
    np.cumsum(income_sorted)
    / np.sum(income_sorted)
)

# Calculate the cumulative share of the population.

population_share = (
    np.arange(1, len(income_sorted) + 1)
    / len(income_sorted)
)

# Plot the Lorenz curve and the line of perfect equality.

plt.figure()

plt.plot(
    population_share,
    income_share,
    label="Lorenz curve"
)

plt.plot(
    [0, 1],
    [0, 1],
    linestyle="--",
    label="Perfect equality"
)

plt.xlabel("Cumulative population share")
plt.ylabel("Cumulative income share")
plt.title("Lorenz curve")
plt.legend()
plt.show()


# e. Gini for each age
# We now calculate inequality separately for each age.

gini_age = []

for t, age in enumerate(model.ages):

    G = gini(
        model.income[:, t]
    )

    gini_age.append(G)

    print(age, G)


# f. compare pooled and within-age inequality
# Compare inequality across the full sample with the
# average Gini coefficient within age groups.

print("Gini, all ages:", gini_all)

print(
    "Average Gini within age:",
    np.mean(gini_age)
)




# ============================================================
# 2.4 What drives inequality?
# ============================================================


# a. function for reporting Gini
# This function simulates a model and returns:
# 1. Gini for all ages pooled
# 2. Gini for individuals aged 45

def report_gini(model, age=45):
    """Compute pooled and age-specific Gini."""

    model.simulate()

    # Gini for all ages pooled
    G_all = gini(
        model.income.flatten()
    )

    # Find the column corresponding to age 45
    t = np.where(
        model.ages == age
    )[0][0]

    # Gini for age 45
    G_age = gini(
        model.income[:, t]
    )

    return G_all, G_age


# b. baseline
# First run the original model without changing anything.

baseline = IncomeModel(seed=123)

G_all_base, G_age_base = report_gini(
    baseline
)


# c. no educational differences
# We make education length, initial human capital and
# human capital growth identical across education groups.

no_education = IncomeModel(seed=123)

no_education.S_e = np.array(
    [3, 3, 3]
)

no_education.h_e0 = np.array(
    [1.20, 1.20, 1.20]
)

no_education.delta_e = np.array(
    [0.020, 0.020, 0.020]
)

G_all_education, G_age_education = report_gini(
    no_education
)


# d. no human capital shocks
# sigma_psi = 0 means that the random human capital
# shock psi is always equal to 1.

no_shocks = IncomeModel(seed=123)

no_shocks.sigma_psi = 0

G_all_shocks, G_age_shocks = report_gini(
    no_shocks
)


# e. no depreciation while unemployed
# delta = 0 means human capital does not depreciate
# when an individual is unemployed.

no_depreciation = IncomeModel(seed=123)

no_depreciation.delta = 0

G_all_depreciation, G_age_depreciation = report_gini(
    no_depreciation
)


# f. no unemployment
# Nobody loses a job and an unemployed individual
# finds a job with probability 1.

no_unemployment = IncomeModel(seed=123)

no_unemployment.lambda_ = 1
no_unemployment.sigma = 0

G_all_unemployment, G_age_unemployment = report_gini(
    no_unemployment
)


# g. report results
# Finally, compare all simulations with the baseline.

print("                    All ages    Age 45")

print(
    "Baseline           ",
    G_all_base,
    G_age_base
)

print(
    "No education       ",
    G_all_education,
    G_age_education
)

print(
    "No shocks          ",
    G_all_shocks,
    G_age_shocks
)

print(
    "No depreciation    ",
    G_all_depreciation,
    G_age_depreciation
)

print(
    "No unemployment    ",
    G_all_unemployment,
    G_age_unemployment
)




# ============================================================
# 2.5 Extension: permanent health risk
# ============================================================

# We add a serious health shock to the model.
# Each year there is a 2% risk of a health shock.
# A health shock:
# 1. reduces human capital by 30%
# 2. increases the probability of losing a job


# ------------------------------------------------------------
# a. Parameters
# ------------------------------------------------------------

p_health = 0.02
health_loss = 0.30
sigma_sick = 0.15


# ------------------------------------------------------------
# b. Create the model
# ------------------------------------------------------------

health_model = IncomeModel(seed=123)

N = health_model.N

# Ages from 18 to 65
ages = np.arange(
    health_model.age_min,
    health_model.age_max + 1
)

T = len(ages)


# ------------------------------------------------------------
# c. Draw education
# ------------------------------------------------------------

education = health_model.rng.choice(
    3,
    size=N,
    p=health_model.p_e
)

education_years = health_model.S_e[education]


# ------------------------------------------------------------
# d. Create arrays
# ------------------------------------------------------------

h = np.zeros((N, T))

employed = np.zeros(
    (N, T),
    dtype=bool
)

income_health = np.zeros((N, T))

# Keeps track of people who have had a health shock
sick = np.zeros(N, dtype=bool)

# Income in previous job
last_job_income = np.zeros(N)


# ------------------------------------------------------------
# e. Simulate the life cycle
# ------------------------------------------------------------

for t, age in enumerate(ages):

    # Who is studying?
    studying = (
        age < health_model.age_min + education_years
    )

    # Who has finished education?
    active = ~studying


    # --------------------------------------------------------
    # Health shock
    # --------------------------------------------------------

    new_sick = (
        (health_model.rng.random(N) < p_health)
        & active
        & (~sick)
    )

    sick[new_sick] = True


    # --------------------------------------------------------
    # Human capital
    # --------------------------------------------------------

    if t == 0:

        # Initial human capital
        h[:, t] = health_model.h_e0[education]

    else:

        # Start with last year's human capital
        h[:, t] = h[:, t-1]

        # Random human capital shock
        psi = health_model.rng.lognormal(
            -0.5 * health_model.sigma_psi**2,
            health_model.sigma_psi,
            size=N
        )

        # Employed last year
        was_employed = employed[:, t-1]

        # Human capital grows when employed
        h[was_employed, t] = (
            h[was_employed, t-1]
            * (1 + health_model.delta_e[education[was_employed]])
            * psi[was_employed]
        )

        # Unemployed last year
        was_unemployed = (
            active & (~was_employed)
        )

        # Human capital depreciates when unemployed
        h[was_unemployed, t] = (
            h[was_unemployed, t-1]
            * (1 - health_model.delta)
            * psi[was_unemployed]
        )

        # New health shock reduces human capital permanently
        h[new_sick, t] = (
            h[new_sick, t]
            * (1 - health_loss)
        )


    # --------------------------------------------------------
    # Employment
    # --------------------------------------------------------

    if t > 0:

        was_employed = employed[:, t-1]

        # Normal probability of losing job
        separation = np.full(
            N,
            health_model.sigma
        )

        # Higher probability after health shock
        separation[sick] = sigma_sick


        # Who loses their job?
        lose_job = (
            health_model.rng.random(N)
            < separation
        )


        # Who finds a job?
        find_job = (
            health_model.rng.random(N)
            < health_model.lambda_
        )


        # Stay employed
        employed[:, t] = (
            was_employed & (~lose_job)
        )

        # Find a new job
        employed[:, t] = (
            employed[:, t]
            | ((~was_employed) & find_job & active)
        )


    # Students cannot work
    employed[studying, t] = False


    # --------------------------------------------------------
    # Income
    # --------------------------------------------------------

    # Student grant
    income_health[studying, t] = health_model.y_SU


    # Employed
    working = active & employed[:, t]

    income_health[working, t] = h[working, t]

    # Remember last job income
    last_job_income[working] = h[working, t]


    # Unemployed
    unemployed = active & (~employed[:, t])

    income_health[unemployed, t] = np.maximum(
        health_model.rho * last_job_income[unemployed],
        health_model.y_floor
    )


# ------------------------------------------------------------
# f. Compare with the original model
# ------------------------------------------------------------

# Gini for all ages

gini_baseline = gini(
    model.income.flatten()
)

gini_health = gini(
    income_health.flatten()
)

print("Baseline Gini:", gini_baseline)
print("Health risk Gini:", gini_health)


# ------------------------------------------------------------
# g. Compare age 45
# ------------------------------------------------------------

t45 = np.where(ages == 45)[0][0]

gini_45_baseline = gini(
    model.income[:, t45]
)

gini_45_health = gini(
    income_health[:, t45]
)

print("Baseline Gini age 45:", gini_45_baseline)
print("Health risk Gini age 45:", gini_45_health)


# ------------------------------------------------------------
# h. Plot mean income
# ------------------------------------------------------------

mean_baseline = np.mean(
    model.income,
    axis=0
)

mean_health = np.mean(
    income_health,
    axis=0
)

plt.figure()

plt.plot(
    ages,
    mean_baseline,
    label="Baseline"
)

plt.plot(
    ages,
    mean_health,
    label="Health risk"
)

plt.xlabel("Age")
plt.ylabel("Mean income")
plt.title("Mean income over the life cycle")
plt.legend()

plt.show()


# ------------------------------------------------------------
# i. Plot income distribution at age 45
# ------------------------------------------------------------

plt.figure()

plt.hist(
    model.income[:, t45],
    bins=50,
    alpha=0.5,
    label="Baseline"
)

plt.hist(
    income_health[:, t45],
    bins=50,
    alpha=0.5,
    label="Health risk"
)

plt.xlabel("Income")
plt.ylabel("Number of individuals")
plt.title("Income distribution at age 45")
plt.legend()

plt.show()


# ------------------------------------------------------------
# j. Share experiencing a health shock
# ------------------------------------------------------------

print(
    "Share experiencing a health shock:",
    np.mean(sick)
)
